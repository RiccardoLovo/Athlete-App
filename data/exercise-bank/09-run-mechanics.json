  "exercises": [
    {
      "id": "ankling",
      "name": "Ankling",
      "aka": "ankle dribbles",
      "family": "run-drill",
      "modifiers": [
        "bodyweight",
        "minimal knee lift"
      ],
      "pattern": "run mechanics",
      "plane": "sagittal",
      "stance": "unilateral alternating",
      "perSide": false,
      "ssc": "fast",
      "gct": "< 200 ms per contact",
      "velocity": "high cadence, low amplitude",
      "joints": [
        "ankle plantarflexion / dorsiflexion (primary)",
        "minimal knee and hip flexion"
      ],
      "agonists": [
        "triceps surae",
        "tibialis anterior"
      ],
      "synergists": [
        "foot intrinsics",
        "hip flexors (small)"
      ],
      "stabilizers": [
        "deep trunk",
        "foot and ankle"
      ],
      "position": "The lowest-amplitude running drill: the foot cycles directly under the hip with almost no knee lift, which trains the foot-strike position and ankle stiffness without the coordination load of a skip. The right first drill for almost anyone.",
      "resistance": "Bodyweight.",
      "lengthBias": "mid",
      "intents": [
        "run mechanics",
        "ankle stiffness"
      ],
      "dose": "3–4 × 15–20 m",
      "stress": {
        "axial": "low",
        "flexion": "low",
        "impact": "low",
        "landing": "low",
        "achilles": "low",
        "knee": "low",
        "shoulder": "low",
        "elbow": "low"
      },
      "equipment": [],
      "equipTier": "none",
      "space": "20 m runway",
      "skill": "entry",
      "cues": [
        "Feet land under the hips, not in front",
        "Quick and light — think hot coals",
        "Barely lift the knees at all"
      ],
      "video": {
        "id": "HvH5WZk0f90",
        "author": "Training & Testing"
      },
      "block": "09-run-mechanics",
      "flags": [
        {
          "field": "video",
          "kind": "unverified",
          "text": "Shares the ABC drill sequence clip with the straight-leg run and butt kicks. The sequence covers it, but it is not isolated — a dedicated clip would coach better."
        }
      ]
    },
    {
      "id": "high-knees",
      "name": "High Knees",
      "aka": null,
      "family": "run-drill",
      "modifiers": [
        "bodyweight",
        "high knee lift",
        "running cadence"
      ],
      "pattern": "run mechanics",
      "plane": "sagittal",
      "stance": "unilateral alternating",
      "perSide": false,
      "ssc": "fast",
      "gct": "< 250 ms per contact",
      "velocity": "high cadence",
      "joints": [
        "hip flexion (large, fast)",
        "knee flexion",
        "ankle plantarflexion"
      ],
      "agonists": [
        "iliopsoas",
        "rectus femoris",
        "triceps surae"
      ],
      "synergists": [
        "gluteus maximus (the drive down)",
        "tibialis anterior",
        "hip flexors"
      ],
      "stabilizers": [
        "deep trunk",
        "erector spinae",
        "foot and ankle"
      ],
      "position": "Trains hip flexion speed and cadence together. The common error is leaning back to get the knees up, which trades the drill's purpose for height — the trunk position matters more than the knee height.",
      "resistance": "Bodyweight.",
      "lengthBias": "mid",
      "intents": [
        "run mechanics",
        "hip flexion speed"
      ],
      "dose": "3–4 × 15–20 m",
      "stress": {
        "axial": "low",
        "flexion": "low",
        "impact": "mod",
        "landing": "low",
        "achilles": "mod",
        "knee": "low",
        "shoulder": "low",
        "elbow": "low"
      },
      "equipment": [],
      "equipTier": "none",
      "space": "20 m runway",
      "skill": "entry",
      "cues": [
        "Stay tall — no leaning back",
        "Cadence over knee height",
        "Push the ground away each step"
      ],
      "video": {
        "id": "_mBXP7fWfFc",
        "author": "Lyfestyle Athletics"
      },
      "block": "09-run-mechanics"
    },
    {
      "id": "a-skip",
      "name": "A-Skip",
      "aka": null,
      "family": "run-drill",
      "modifiers": [
        "bodyweight",
        "skip rhythm",
        "knee drive"
      ],
      "pattern": "run mechanics",
      "plane": "sagittal",
      "stance": "unilateral alternating",
      "perSide": false,
      "ssc": "fast",
      "gct": "< 250 ms per contact",
      "velocity": "rhythmic, high",
      "joints": [
        "hip flexion then extension (cyclic)",
        "knee flexion",
        "ankle plantarflexion",
        "opposite-arm drive"
      ],
      "agonists": [
        "iliopsoas",
        "rectus femoris",
        "gluteus maximus",
        "triceps surae"
      ],
      "synergists": [
        "hamstrings",
        "tibialis anterior",
        "deltoids (arm drive)"
      ],
      "stabilizers": [
        "deep trunk",
        "gluteus medius",
        "foot and ankle"
      ],
      "position": "Adds a skip rhythm to the knee drive, which forces the ground contact to be short and the limb cycle to be timed. Trains the recovery and drive phases of the stride as a coordinated unit rather than in isolation.",
      "resistance": "Bodyweight.",
      "lengthBias": "mid",
      "intents": [
        "run mechanics",
        "coordination"
      ],
      "dose": "3–4 × 15–20 m",
      "stress": {
        "axial": "low",
        "flexion": "low",
        "impact": "mod",
        "landing": "low",
        "achilles": "mod",
        "knee": "low",
        "shoulder": "low",
        "elbow": "low"
      },
      "equipment": [],
      "equipTier": "none",
      "space": "20 m runway",
      "skill": "intermediate",
      "cues": [
        "Knee up, then paw the ground down and back",
        "Tall posture, arms driving opposite the legs",
        "Short ground contact — do not sink"
      ],
      "video": {
        "id": "5AfQrStwtos",
        "author": "Lyfestyle Athletics"
      },
      "block": "09-run-mechanics"
    },
    {
      "id": "b-skip",
      "name": "B-Skip",
      "aka": null,
      "family": "run-drill",
      "modifiers": [
        "bodyweight",
        "skip rhythm",
        "active leg extension"
      ],
      "pattern": "run mechanics",
      "plane": "sagittal",
      "stance": "unilateral alternating",
      "perSide": false,
      "ssc": "fast",
      "gct": "< 250 ms per contact",
      "velocity": "rhythmic",
      "joints": [
        "hip flexion then knee extension then hip extension (cyclic)",
        "ankle plantarflexion"
      ],
      "agonists": [
        "hamstrings (the pawback)",
        "gluteus maximus",
        "iliopsoas"
      ],
      "synergists": [
        "rectus femoris (the reach)",
        "triceps surae",
        "tibialis anterior"
      ],
      "stabilizers": [
        "deep trunk",
        "gluteus medius",
        "erector spinae"
      ],
      "position": "Adds an active leg extension and pawback to the A-skip, which loads the hamstrings at long length at speed — the same tissue demand as the end of the swing phase in fast running, and the reason B-skips are both valuable and a common source of hamstring complaints when introduced too fast.",
      "resistance": "Bodyweight.",
      "lengthBias": "lengthened",
      "intents": [
        "run mechanics",
        "hamstring coordination"
      ],
      "dose": "3–4 × 15–20 m",
      "stress": {
        "axial": "low",
        "flexion": "low",
        "impact": "mod",
        "landing": "low",
        "achilles": "mod",
        "knee": "low",
        "shoulder": "low",
        "elbow": "low"
      },
      "equipment": [],
      "equipTier": "none",
      "space": "20 m runway",
      "skill": "advanced",
      "cues": [
        "Knee up, reach the foot out, then pull it down and back",
        "Do not snap the knee straight — reach, then paw",
        "Build in slowly; this one finds cold hamstrings"
      ],
      "video": {
        "id": "Zy97yNE7WEE",
        "author": "StrengthRunning"
      },
      "block": "09-run-mechanics"
    },
    {
      "id": "straight-leg-run",
      "name": "Straight Leg Run",
      "aka": "stiff-leg shuffle",
      "family": "run-drill",
      "modifiers": [
        "bodyweight",
        "knees near-locked"
      ],
      "pattern": "run mechanics",
      "plane": "sagittal",
      "stance": "unilateral alternating",
      "perSide": false,
      "ssc": "fast",
      "gct": "< 200 ms per contact",
      "velocity": "high cadence",
      "joints": [
        "hip flexion and extension with the knee held extended",
        "ankle plantarflexion"
      ],
      "agonists": [
        "hamstrings",
        "gluteus maximus",
        "triceps surae"
      ],
      "synergists": [
        "iliopsoas",
        "tibialis anterior"
      ],
      "stabilizers": [
        "deep trunk",
        "erector spinae",
        "foot and ankle"
      ],
      "position": "Locking the knee forces the hip to do all the work and the foot to strike under the body, so it isolates the pawback action and loads the hamstrings at long length with every contact. A sharp drill and an easy way to strain something if the athlete is not warm.",
      "resistance": "Bodyweight.",
      "lengthBias": "lengthened",
      "intents": [
        "run mechanics",
        "hamstring coordination"
      ],
      "dose": "3 × 15–20 m",
      "stress": {
        "axial": "low",
        "flexion": "low",
        "impact": "mod",
        "landing": "low",
        "achilles": "high",
        "knee": "low",
        "shoulder": "low",
        "elbow": "low"
      },
      "equipment": [],
      "equipTier": "none",
      "space": "20 m runway",
      "skill": "intermediate",
      "cues": [
        "Legs long, strike under the hip",
        "Quick cycling, not big steps",
        "Only when thoroughly warm"
      ],
      "video": {
        "id": "HvH5WZk0f90",
        "author": "Training & Testing",
        "note": "covered within the ABC drill sequence"
      },
      "flags": [
        {
          "field": "video",
          "kind": "unverified",
          "text": "Shares a video with the ankling record — the clip runs through several ABC drills in sequence rather than isolating this one. Fine for a coach who knows what to look for, thin for an athlete following along alone."
        }
      ],
      "block": "09-run-mechanics"
    },
    {
      "id": "butt-kicks",
      "name": "Butt Kicks",
      "aka": "heel flicks",
      "family": "run-drill",
      "modifiers": [
        "bodyweight",
        "heel recovery"
      ],
      "pattern": "run mechanics",
      "plane": "sagittal",
      "stance": "unilateral alternating",
      "perSide": false,
      "ssc": "fast",
      "gct": "< 250 ms per contact",
      "velocity": "high cadence",
      "joints": [
        "knee flexion (fast, cyclic)",
        "hip extension then flexion"
      ],
      "agonists": [
        "hamstrings (knee flexion)"
      ],
      "synergists": [
        "gastrocnemius",
        "iliopsoas",
        "gluteus maximus"
      ],
      "stabilizers": [
        "deep trunk",
        "erector spinae"
      ],
      "position": "Trains the heel recovery phase — the fast knee flexion that shortens the swing leg's lever so it can come through quickly. Should happen under the hip, not behind the body; kicking the backside while leaning forward is the usual error and trains nothing useful.",
      "resistance": "Bodyweight.",
      "lengthBias": "shortened",
      "intents": [
        "run mechanics",
        "cadence"
      ],
      "dose": "3 × 15–20 m",
      "stress": {
        "axial": "low",
        "flexion": "low",
        "impact": "mod",
        "landing": "low",
        "achilles": "mod",
        "knee": "low",
        "shoulder": "low",
        "elbow": "low"
      },
      "equipment": [],
      "equipTier": "none",
      "space": "20 m runway",
      "skill": "entry",
      "cues": [
        "Heel comes up under the hip, not behind you",
        "Stay tall",
        "Fast and light"
      ],
      "video": {
        "id": "HvH5WZk0f90",
