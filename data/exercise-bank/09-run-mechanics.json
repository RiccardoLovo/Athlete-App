    "ssc": [
      {
        "id": "none",
        "label": "No SSC",
        "definition": "Dead start or paused. No elastic contribution; force comes from rate of development alone."
      },
      {
        "id": "slow",
        "label": "Slow SSC",
        "definition": "Contact > 250 ms, large joint displacement. Countermovement assists the jump."
      },
      {
        "id": "fast",
        "label": "Fast SSC",
        "definition": "Contact < 250 ms, small displacement. Trains tendon stiffness and reactive strength."
      },
      {
        "id": "ecc",
        "label": "Eccentric only",
        "definition": "Deceleration and landing. No concentric phase to train."
      },
      {
        "id": "n/a",
        "label": "Not applicable",
        "definition": "Grinding or isolation work where the stretch-shortening cycle is not the organizing variable."
