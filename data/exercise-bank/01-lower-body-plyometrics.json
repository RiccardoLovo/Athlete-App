    {
      "id": "sbj-planted",
      "name": "Seated Box Jump",
      "aka": "feet planted",
      "family": "seated-jump",
      "modifiers": [
        "target box",
        "feet planted"
      ],
      "pattern": "vertical jump",
      "plane": "sagittal",
      "stance": "bilateral",
      "perSide": false,
      "ssc": "none",
      "gct": "n/a \u2014 no prior ground contact",
      "velocity": "maximal concentric",
      "joints": [
        "knee extension (large, fast)",
        "hip extension (large, fast)",
        "ankle plantarflexion (moderate)"
      ],
      "agonists": [
        "vastus lateralis / medialis / intermedius",
        "gluteus maximus"
      ],
      "synergists": [
        "rectus femoris",
        "gastrocnemius",
        "soleus",
        "adductor magnus (hip ext)"
      ],
      "stabilizers": [
        "erector spinae (isometric, low)",
        "deep trunk"
      ],
      "position": "Hip deeply flexed, thigh ~horizontal at start. The rectus femoris is biarticular and already shortened across the flexed hip, so it suffers active insufficiency and the monoarticular vasti dominate knee extension \u2014 the same reason squats grow the vasti preferentially. This is why it is not interchangeable with a standing jump despite an identical muscle list.",
      "resistance": "Bodyweight. Peak demand at initiation; no elastic return available.",
      "lengthBias": null,
      "intents": [
        "concentric RFD"
      ],
      "dose": "3\u20136 \u00d7 3\u20135, full recovery, end of session",
      "stress": {
        "axial": "low",
        "flexion": "low",
        "impact": "mod",
