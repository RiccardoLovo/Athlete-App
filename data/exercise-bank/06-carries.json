  "exercises": [
    {
      "id": "farmer-carry",
      "name": "Farmer Carry",
      "aka": null,
      "family": "carry",
      "modifiers": [
        "bilateral",
        "load at the sides"
      ],
      "pattern": "loaded carry",
      "plane": "sagittal",
      "stance": "bilateral",
      "perSide": false,
      "ssc": "none",
      "gct": "n/a",
      "velocity": "walking",
      "joints": [
        "trunk anti-flexion (isometric)",
        "scapular depression (isometric)",
        "gait"
      ],
      "agonists": [
        "grip and forearm flexors",
        "upper trapezius",
        "deep trunk"
      ],
      "synergists": [
        "erector spinae",
        "obliques",
        "gluteus medius (gait)",
        "calves"
      ],
      "stabilizers": [
        "deep trunk",
        "scapular stabilizers",
        "foot and ankle"
      ],
      "position": "Load hangs from the hands, so the spine is loaded in traction rather than compression and the limit is almost always grip. The most transferable loaded-carry variant and the easiest to prescribe to a back that dislikes compression.",
      "resistance": "External, hanging. Grip-limited.",
      "lengthBias": "mid",
      "intents": [
        "grip strength",
        "trunk endurance",
        "conditioning"
      ],
      "dose": "3–5 × 20–40 m, or 30–60 s",
      "stress": {
        "axial": "low",
        "flexion": "low",
        "impact": "low",
        "landing": "low",
        "achilles": "low",
        "knee": "low",
        "shoulder": "low",
        "elbow": "low"
      },
      "equipment": [
        "dumbbells or kettlebells"
      ],
      "equipTier": "minimal",
      "space": "20 m walkway",
      "skill": "entry",
      "cues": [
        "Tall posture, shoulders packed down",
        "Short deliberate steps",
        "Stop when the grip goes, not the legs"
      ],
      "video": {
        "id": "G-_FYQfur9w",
