    {
      "id": "single-arm-farmer-carry",
      "name": "Single Arm Farmer Carry",
      "aka": "suitcase carry",
      "family": "carry",
      "modifiers": [
        "unilateral",
        "load at one side"
      ],
      "pattern": "loaded carry",
      "plane": "frontal",
      "stance": "unilateral",
      "perSide": true,
      "ssc": "none",
      "gct": "n/a",
      "velocity": "walking",
      "joints": [
        "trunk anti-lateral-flexion (isometric, loaded)",
        "gait",
        "scapular depression"
      ],
      "agonists": [
        "obliques (non-carrying side)",
        "quadratus lumborum",
        "grip"
      ],
      "synergists": [
        "gluteus medius",
        "erector spinae",
        "upper trapezius"
      ],
      "stabilizers": [
        "deep trunk",
        "gluteus medius (high)",
        "foot and ankle"
      ],
      "position": "Asymmetric load turns a carry into the most practical anti-lateral-flexion exercise there is — the trunk refuses a side bend while walking. Far closer to how lateral trunk strength is used than a side bend is.",
      "resistance": "External, one side. Grip- and trunk-limited.",
      "lengthBias": "mid",
      "intents": [
        "anti-lateral flexion",
        "grip strength"
      ],
      "dose": "3–4 × 20–40 m per side",
      "stress": {
        "axial": "low",
        "flexion": "low",
        "impact": "low",
        "landing": "low",
        "achilles": "low",
        "knee": "low",
        "shoulder": "low",
        "elbow": "low"
      },
      "equipment": [
        "dumbbell or kettlebell"
      ],
      "equipTier": "minimal",
      "space": "20 m walkway",
      "skill": "entry",
      "cues": [
        "Stay vertical — do not lean away from the weight",
        "Shoulders level",
        "Match the distance on both sides"
      ],
      "video": {
        "id": "ZvUkhUesX0Y",
        "author": "Catalyst Athletics"
      },
      "block": "06-carries"
    },
    {
